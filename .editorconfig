# EditorConfig (https://editorconfig.org): every editor reads this, so indentation and line
# endings are never a review comment. VS Code needs the "EditorConfig for VS Code" extension.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.java]
indent_size = 4

# Windows-native scripts keep CRLF, matching .gitattributes
[*.{cmd,ps1}]
end_of_line = crlf
