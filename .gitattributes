# Line endings: Git stores every text file with LF and checks it out with LF, on every OS,
# so Windows and the Linux CI runners see byte-identical files and bash scripts never carry a "\r".
* text=auto eol=lf

# Windows-native scripts are the exception: cmd.exe and PowerShell expect CRLF.
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Never touch the bytes of these (no line-ending conversion, no text diffs).
*.png binary
*.ogg binary
*.m4a binary
